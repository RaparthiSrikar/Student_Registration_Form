# Django Environment Variables for Vercel Deployment

# Generate a strong secret key for production (e.g. using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=your-production-secret-key-here

# Set DEBUG to False in production
DEBUG=False

# Allowed hosts (comma-separated domains)
ALLOWED_HOSTS=.vercel.app,your-custom-domain.com

# (Optional) External PostgreSQL Database URL (e.g. Neon, Supabase, Vercel Postgres)
# DATABASE_URL=postgres://user:password@host:port/dbname
